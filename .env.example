# Database
POSTGRES_DB=buildflow
POSTGRES_USER=buildflow
POSTGRES_PASSWORD=change_me_in_every_environment

JWT_SECRET=development-only-secret-change-me-32-bytes-minimum
JWT_TTL_SECONDS=900
APP_ALLOWED_ORIGINS=http://localhost:3000
# Local development only: returns the reset token in the response instead of emailing it.
AUTH_RETURN_RESET_TOKEN=false

# Platform super admin — first operator account, created at startup.
#
# The account is created with "must change password" set: the seeded credential is enough to sign
# in and replace itself, and the API refuses every administrative call until that is done. So a
# password here is a one-time handover, not a standing key — but it is still a real credential, so
# generate one rather than reusing anything, and never commit the .env it lives in.
PLATFORM_OWNER_EMAIL=admin@buildflow.africa
PLATFORM_OWNER_PASSWORD=BuildFlow@2026!Admin
PLATFORM_OWNER_NAME=Platform Super Admin

# Storage
STORAGE_ROOT=/data/uploads
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_every_environment

# Services
BACKEND_URL=http://backend:8080
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_SECONDS=30

# AI provider — optional. Without a key the AI service uses deterministic construction logic.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
